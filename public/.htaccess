# Apache-Konfiguration für www.proimma.de
# Stand 08.05.2026, Live-Gang-Bauauftrag.

# Block 1 Schritt 1.4: ErrorDocument für die Astro-Top-Level-Fehler-Seite.
ErrorDocument 404 /404.html

# Block 2 Schritt 2.1a: Domain-Kanonisierung proimma.de auf www.proimma.de.
# Aufrufe ohne www werden mit 301 auf die kanonische Live-Domain umgeleitet,
# einschließlich Pfad und Query-String über REQUEST_URI.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^proimma\.de$ [NC]
  RewriteRule ^(.*)$ https://www.proimma.de%{REQUEST_URI} [L,R=301]
</IfModule>

# Block 2 Schritt 2.1b: 301-Weiterleitungen alter WordPress-Pfade auf die
# neue Astro-Struktur, gemäß WordPress-URL-Inventur vom 04.05.2026.
RedirectMatch 301 ^/leistungen/?$ https://www.proimma.de/hausverwaltung/
RedirectMatch 301 ^/ueber-uns/?$ https://www.proimma.de/ueber-proimma/
RedirectMatch 301 ^/termin/?$ https://www.proimma.de/kontakt/
RedirectMatch 301 ^/impressum/?$ https://www.proimma.de/impressum/
RedirectMatch 301 ^/elementor-seite-18/?$ https://www.proimma.de/

# Block 2 Schritt 2.2: sechs OWASP-HTTP-Sicherheitsheader.
# Plausible aktuell nicht produktiv eingebunden; CSP-Direktive bleibt für die
# Phase-2-Aktivierung vorbereitet. Cal.com-Frame-Hosts in frame-src ergänzt.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://plausible.io https://sibforms.com; style-src 'self' 'unsafe-inline' https://sibforms.com; img-src 'self' data: https:; font-src 'self' data: https://assets.brevo.com; connect-src 'self' https://plausible.io https://*.sibforms.com; frame-src 'self' https://*.sibforms.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://*.sibforms.com"
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
</IfModule>
