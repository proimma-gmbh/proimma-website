---
// Startseite Proimma — Editorial Bold
// Stand 02.05.2026, Bau-Block 2.
//
// Inhalt dieser Etappe:
//  01 Hero V2 mit XXL-Display-Headline (Bau-Block 1).
//  02 Hero-Datenpunkte V3 mit drei Datenpunkten (Bau-Block 2).
//  03 Editorial-Verzichtsblock V14 mit vier Verzichtsaussagen (Bau-Block 2).
//
// Andere Sektionen (Säule Mietenverwaltung, Säule Maklerei, Substanz-Vertrauensanker,
// Personenprofil, Themen-Hub-Vorschau, Cal.eu-Termin-Sektion) folgen in den
// späteren Bau-Blöcken.
//
// Quelle Wortlaute: /00_Projekt_Setup_2026/Webseiten-Texte/06_Startseite_2026-04-27.md
// (vom Texter-Chat freigegeben am 28.04.2026) plus Probebau vom 30.04.2026.
// Pflicht-Wortlaute § 34c-Erlaubnis und § 15 MaBV-Hinweis aus Auftrag eins zu eins.

import BaseLayout from '@/layouts/BaseLayout.astro';

const title = 'Hausverwaltung und Maklerei in Rostock. Proimma GmbH';
const description = 'Mietenverwaltung und Vermarktung von Wohnimmobilien für Eigentümer in Rostock und Umgebung. Inhabergeführt, fokussiert. Erstgespräch online vereinbaren.';
// Seitenspezifisches OG-Bild, Stand 06.05.2026.
const ogImage = '/og-images/og-startseite.png';

// Datenpunkte für Sektion 02
// Wortlaute auf 02.05.2026 angeglichen an die freigegebenen Texte
// (01_Hausverwaltung, 06_Startseite, 08_Über-Proimma).
const datenpunkte = [
  {
    wert: '20+',
    label: '01 Erfahrung',
    text: 'Mehr als zwanzig Jahre Branchenerfahrung. Stationen als Immobilienkaufmann, Asset Manager für einen dänischen Fonds, Mitaufbau einer Hausverwaltung sowie als Hausverwalter und Bewirtschafter in Anstellung.',
  },
  {
    wert: '1 Werktag',
    label: '02 Reaktion',
    text: 'Erste Rückmeldung auf Eigentümer-Anfragen innerhalb eines Werktages. Separate Notfall-Erreichbarkeit für Mieter rund um die Uhr.',
  },
  {
    wert: '§ 34c',
    label: '03 Erlaubnis',
    text: 'Einheitliche gewerberechtliche Erlaubnis nach § 34c Absatz 1 Satz 1 Nummer 1 und Nummer 4 GewO der Hansestadt Rostock.',
  },
];

// Verzichtsaussagen für Sektion 03
// Wortlaute eins zu eins aus 06_Startseite_2026-04-27.md, Sektion 03.
// Vier Aussagen final (Stand 03.05.2026, Workspace-Text 06_Startseite, Sektion 03);
// der Vermittlungs-Hinweis steht als eigener Block direkt unter der Liste.
const verzichtsaussagen = [
  'Keine Eigentümergemeinschaften aus mehreren Einzeleigentümern.',
  'Keine reinen Gewerbeimmobilien.',
  'Keine Mandate, deren Bewirtschaftung sich auf eine kurzfristige Abwicklung beschränkt.',
  'Kein Home Staging. Keine 360-Grad-Foto-Touren.',
];

// Themen-Hub-Karten für Sektion 08
// Headlines und URLs aus den freigegebenen Artikel-Texten 02 bis 05.
// Anrisse kondensiert aus den Volltexten, Lese-Dauern grob geschätzt
// nach Wortanzahl der jeweiligen Datei (Andre: bitte prüfen).
const themenKarten = [
  {
    nummer: '01',
    titel: 'Wechsel der Hausverwaltung',
    anriss: 'Welche Punkte Eigentümer vorab für sich klären, welche rechtlichen Mindeststandards eine Verwaltung erfüllen muss und wie eine saubere Übergabe abläuft.',
    leseDauer: '7 min',
    href: '/wissen/verwalterwechsel',
  },
  {
    nummer: '02',
    titel: 'Saubere Bestandsübergabe',
    anriss: 'Stichtag-Logik, kaufmännische und technische Übergabe. Was im Übergabe-Schritt sauber dokumentiert wird, trägt die nächsten Jahre.',
    leseDauer: '6 min',
    href: '/wissen/bestandsuebergabe',
  },
  {
    nummer: '03',
    titel: 'Maklerprovision nach § 656c BGB',
    anriss: 'Wie die Provision konkret gerechnet wird, für welche Geschäfte das Teilungsgebot gilt und wann die Provision fällig wird.',
    leseDauer: '5 min',
    href: '/wissen/maklerprovision',
  },
];

// Pflicht-Aussagen für Sektion 06 Substanz-Vertrauensanker
// Quelle: Übergabe-Prompt 02.05.2026, Pflicht-Wortlaute eins zu eins.
// Korrektur 02.05.2026: Police-Zahlen aus Punkt 04 entfernt, weil die externe
// Kommunikationsregel Proimma keine Zahlen in der Außendarstellung erlaubt.
const substanzPunkte = [
  'Mehr als zwanzig Jahre Branchenerfahrung des Inhabers.',
  'Werktags 9 bis 17 Uhr unter 0173 6335917 erreichbar.',
  'Notfall-Erreichbarkeit für Mieter rund um die Uhr über die separate Notfall-Nummer im Mietvertrag.',
  'Vermögensschadenhaftpflicht-Versicherung gemäß § 15 MaBV.',
  'Erlaubnis nach § 34c Absatz 1 Satz 1 Nummer 1 und Nummer 4 GewO der Hansestadt Rostock.',
];
---

<BaseLayout title={title} description={description} ogImage={ogImage}>

  <!-- 01 HERO V2 — Editorial-XXL-Headline ohne Foto, Hellblau-Akzentstrich
       Bau-Block 2.1: Reveal-Animation entfernt (Above-the-Fold), Schrift kompakter,
       max-width auf 22ch erweitert, Hero-Padding reduziert für ersten Sichtbereich. -->
  <section class="hero" data-sektion="hero">
    <div class="container-page hero-grid">
      <div class="hero-strich"><div class="ed-strich"></div></div>
      <h1 class="hero-headline">Hausverwaltung und Maklerei in Rostock. Inhabergeführt. Fokussiert.</h1>
      <p class="hero-subline">Mietenverwaltung und Vermarktung von Wohnimmobilien für Eigentümer in Rostock und Umgebung.</p>
      <div class="hero-cta">
        <a class="btn-primary" href="/kontakt" data-cta="erstgespraech-cta-hero">Erstgespräch vereinbaren</a>
      </div>
    </div>
  </section>

  <!-- 02 HERO-DATENPUNKTE V3 — drei Datenpunkte mit Tabular Nums -->
  <section class="data" data-sektion="datenpunkte">
    <div class="container-page data-grid">
      {datenpunkte.map((item) => (
        <div class="data-item reveal">
          <div class="data-strich" aria-hidden="true"></div>
          <div class="data-value nums">{item.wert}</div>
          <div class="data-label">{item.label}</div>
          <p class="data-text">{item.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- 03 EDITORIAL-VERZICHTSBLOCK V14 — vier Verzichtsaussagen plus Vermittlungs-Hinweis
       Wortlaute eins zu eins aus 06_Startseite_2026-04-27.md. -->
  <section class="verzicht" data-sektion="verzicht">
    <div class="container-page verzicht-grid">
      <div class="reveal">
        <div class="ed-index">03 Was bei Proimma nicht stattfindet</div>
        <h2 class="verzicht-headline">Klares Profil. Auch durch Verzicht.</h2>
        <p class="verzicht-lead">Diese Klarheit schützt die Qualität der Mandate, die wir tatsächlich führen.</p>
      </div>
      <div class="verzicht-list reveal">
        {verzichtsaussagen.map((text, idx) => (
          <div class="verzicht-row">
            <span class="verzicht-num nums">{String(idx + 1).padStart(2, '0')}</span>
            <span class="verzicht-text">{text}</span>
          </div>
        ))}
        <p class="verzicht-hinweis">
          Für Eigentümergemeinschaften, die einen Verwalter suchen, vermitteln wir auf Wunsch den Kontakt zu einer auf diesen Bereich spezialisierten Verwalterin in Rostock.
        </p>
      </div>
    </div>
  </section>

  <!-- 04 SÄULE HAUSVERWALTUNG V4 — Magazin-Band mit Service-Punkten
       Lead aus 06_Startseite_2026-04-27.md eins zu eins.
       Body und Service-Punkte aus 01_Hausverwaltung_2026-04-27.md
       gekürzt auf Startseiten-Format, Wortlaute aus dem Texter-Chat. -->
  <section class="band" id="hausverwaltung" data-sektion="mietenverwaltung">
    <div class="container-page band-grid">
      <div class="band-meta reveal">
        <div class="ed-index">04 Hausverwaltung</div>
      </div>
      <div class="band-content reveal">
        <h2 class="band-headline">Mietenverwaltung für Mehrfamilienhäuser. Aus einer Hand.</h2>
        <p class="band-lead">Mietenverwaltung von Mehrfamilienhäusern sowie von Wohn- und Geschäftshäusern für Eigentümer und Eigentümergesellschaften. Mit dokumentiertem Übernahme-Prozess und einem direkten Ansprechpartner ohne Weiterleitung über mehrere Mitarbeiter.</p>
        <div class="band-body">
          <p>Sie übertragen Proimma die laufende Verantwortung für das Objekt im vereinbarten Umfang. Verwaltet wird die Substanz und der Betrieb des Gebäudes für einen Eigentümer oder für eine Eigentümergesellschaft.</p>
          <p>Bei jedem Auftrag bleibt der Inhaber Ansprechpartner. Für laufende Hausmeisterarbeit steht ein fester Hausmeisterdienst aus dem Rostocker Umland bereit, ergänzt durch ausgewählte Handwerker aus dem beruflichen Netzwerk des Inhabers.</p>
        </div>
        <div class="band-services">
          <div class="svc">
            <span class="svc-num nums">01</span>
            <div>
              <div class="svc-name">Kaufmännische Verwaltung</div>
              <p class="svc-text">Sollstellung und laufende Buchung der Mieten, Mieterkonten und Mahnwesen, jährliche Betriebskostenabrechnung, Verwaltung von Mietkautionen mit getrennter Kontenführung auf Wunsch, Mietanpassungen im gesetzlich Zulässigen, Eigentümer-Reporting im vereinbarten Rhythmus.</p>
            </div>
          </div>
          <div class="svc">
            <span class="svc-num nums">02</span>
            <div>
              <div class="svc-name">Technische Verwaltung</div>
              <p class="svc-text">Annahme und Bearbeitung von Mängelmeldungen, Begleitung größerer Instandsetzungen mit Angebotseinholung, Pflege wiederkehrender Wartungen und Prüfungen am Objekt, Begehungen nach Vereinbarung.</p>
            </div>
          </div>
          <div class="svc">
            <span class="svc-num nums">03</span>
            <div>
              <div class="svc-name">Übergaben und Abnahmen</div>
              <p class="svc-text">Bei Mieterwechseln gesonderte Leistung mit Protokoll und Foto-Dokumentation.</p>
            </div>
          </div>
          <div class="svc">
            <span class="svc-num nums">04</span>
            <div>
              <div class="svc-name">Mieter-Erreichbarkeit</div>
              <p class="svc-text">Werktägliche Bürozeit Montag bis Freitag 9 bis 17 Uhr, separate Notfall-Erreichbarkeit für Mieter rund um die Uhr, vollständige digitale Dokumentenablage in der Verwaltungssoftware Immocloud mit Eigentümer- und Mieterportal.</p>
            </div>
          </div>
        </div>
        <a href="/hausverwaltung" class="link-arrow band-link" data-cta="hausverwaltung-mehr">Wie der Wechsel der Hausverwaltung abläuft</a>
      </div>
    </div>
  </section>

  <!-- 05 SÄULE MAKLEREI V6 — Magazin-Band mit § 656c BGB-Provisionslogik
       Lead aus 06_Startseite_2026-04-27.md.
       Body 1 und Provisionslogik aus 07_Maklerei_2026-04-28.md eins zu eins. -->
  <section class="band band-makler" id="maklerei" data-sektion="maklerei">
    <div class="container-page band-grid">
      <div class="band-meta reveal">
        <div class="ed-index">05 Maklerei</div>
      </div>
      <div class="band-content reveal">
        <h2 class="band-headline">Vermarktung von Wohnimmobilien. Mit eigenem Video. Im Videocall.</h2>
        <p class="band-lead">Vermarktung von Einfamilienhäusern, Doppel- und Reihenhäusern, Eigentumswohnungen, Mehrfamilienhäusern und Grundstücken. Provisionslogik nach &sect; 656c BGB transparent, Maklervertrag in Textform vor Auftragserteilung zur Sichtung.</p>
        <div class="band-body">
          <p>Standard bei Proimma sind ein hochwertiges Exposé und professionelle Fotografie. Bei jedem Maklerauftrag wird zusätzlich ein eigenes Video von der Immobilie gedreht und Interessenten ausschließlich in einem Videocall präsentiert. Die Videos werden nicht auf Portalen veröffentlicht; sie sind Teil der direkten Käuferansprache.</p>
          <p>Die Gesamtprovision für die Vermittlung einer Wohnimmobilie beträgt 7,14 Prozent inklusive gesetzlicher Mehrwertsteuer, bezogen auf den notariellen Kaufpreis. Geteilt wird zu gleichen Teilen zwischen Käufer und Verkäufer, also je 3,57 Prozent inklusive Mehrwertsteuer. Fällig wird die Provision ausschließlich im Erfolgsfall mit notarieller Beurkundung. Diese Logik gilt nach &sect; 656c BGB für Eigentumswohnungen und Einfamilienhäuser, wenn der Käufer Verbraucher ist. Bei Mehrfamilienhäusern, Gewerbeobjekten und reinen Grundstücken sind Höhe und Verteilung der Provision frei vereinbar.</p>
        </div>
        <a href="/maklerei" class="link-arrow band-link" data-cta="maklerei-mehr">Zur Maklerei-Seite</a>
      </div>
    </div>
  </section>

  <!-- 06 SUBSTANZ-VERTRAUENSANKER V7 — fünf Pflicht-Aussagen
       Pflicht-Wortlaute aus Übergabe-Prompt 02.05.2026 eins zu eins.
       Hellblau-Akzent ausschließlich bei den Editorial-Index-Nummern 01–05. -->
  <section class="substanz" data-sektion="vertrauen">
    <div class="container-page">
      <div class="substanz-head reveal">
        <div class="ed-index">06 Substanz</div>
        <h2 class="substanz-headline">Was Sie wissen sollten.</h2>
      </div>
      <div class="substanz-list reveal">
        {substanzPunkte.map((text, idx) => (
          <div class="substanz-row">
            <span class="substanz-num nums">{String(idx + 1).padStart(2, '0')}</span>
            <p class="substanz-text">{text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 07 EDITORIAL-PERSONENPROFIL V9 — Foto plus Berufsbiografie
       Pfad /img/andre-portrait.jpg, Astro-Build kopiert es ins dist/.
       Foto in natürlicher Farbe (kein Schwarzweiß-Filter) gemäß
       Korrektur Andre vom 02.05.2026. -->
  <section class="person" id="proimma" data-sektion="personenprofil">
    <div class="container-page person-grid">
      <figure class="person-portrait reveal">
        <img
          src="/img/andre-portrait.jpg"
          alt="André Dieckmann, Inhaber und Geschäftsführer der Proimma GmbH."
          loading="lazy"
        />
      </figure>
      <div class="person-content reveal">
        <div class="ed-index">07 Inhaber</div>
        <h2 class="person-headline">André Dieckmann</h2>
        <div class="person-role">Inhaber und Geschäftsführer</div>
        <p class="person-lead">Proimma wird geführt von André Dieckmann. Er ist seit mehr als zwanzig Jahren in der Immobilienwirtschaft tätig.</p>
        <p class="person-bio">André Dieckmann ist ausgebildeter Immobilienkaufmann. Daran schloss langjährige Tätigkeit in Verkauf und Vermietung im Auftrag Dritter an. Mehrere Jahre war er Asset Manager für einen dänischen Fonds. Es folgten der Mitaufbau einer Hausverwaltung von der Gründungsphase bis in den laufenden Betrieb sowie mehrjährige Tätigkeit als Hausverwalter und Bewirtschafter in Anstellung.</p>
        <p class="person-bio-secondary">Heute Inhaber und alleinvertretungsberechtigter Geschäftsführer der Proimma GmbH mit den beiden Geschäftsbereichen Mietenverwaltung und Maklerei in Rostock und Umgebung.</p>
        <a href="/ueber-proimma" class="link-arrow band-link" data-cta="ueber-andre">Mehr über André</a>
      </div>
    </div>
  </section>

  <!-- 08 THEMEN-HUB-VORSCHAU V8 — Editorial-Karten zu den vier Wissens-Beiträgen
       Quelle: freigegebener Startseiten-Text 06_Startseite_2026-04-27.md, Sektion 04. -->
  <section class="themen" data-sektion="wissen-fuer-eigentuemer">
    <div class="container-page">
      <div class="themen-head reveal">
        <div>
          <div class="ed-index">08 Wissen für Eigentümer</div>
          <h2 class="themen-headline">Wissen für Eigentümer.</h2>
        </div>
        <p class="themen-lead">Sachlich aufbereitete Beiträge zu Themen aus Hausverwaltung und Maklerei. Verwalterwechsel, Bestandsübergabe, Maklerprovision nach &sect; 656c BGB, Verkauf einer Wohnimmobilie in Rostock.</p>
      </div>
      <div class="themen-list reveal">
        {themenKarten.map((karte) => (
          <a href={karte.href} class="themen-item" data-cta={`wissen-${karte.nummer}`}>
            <span class="themen-num nums">{karte.nummer}</span>
            <div class="themen-body">
              <div class="themen-title">{karte.titel}</div>
              <p class="themen-anriss">{karte.anriss}</p>
            </div>
            <span class="themen-meta nums">{karte.leseDauer}</span>
          </a>
        ))}
      </div>
      <a href="/wissen" class="link-arrow themen-link" data-cta="wissen-alle">Alle Beiträge ansehen</a>
    </div>
  </section>

  <!-- 09 CAL.EU-TERMIN-SEKTION — Erstgespräch buchen
       Phase-1b dritte Stufe 12.05.2026: iFrame-Einbettung komplett entfernt,
       weil moderne Chrome-Varianten den Cal.eu-iframe wegen Drittanbieter-
       Cookie-Schutz blockieren und stattdessen eine graue Block-Box zeigen.
       Stattdessen nur ein Direkt-Link-Button, der cal.eu/proimma/30min in
       einer neuen Browser-Ansicht öffnet. Datenschutz-Anpassung der
       Cal.com-iframe-Passage als Klein-Pendenz. -->
  <section class="termin" id="kontakt" data-sektion="cal-embed">
    <div class="container-page termin-inner">
      <div class="termin-head reveal">
        <div class="ed-index">09 Erstgespräch</div>
        <h2 class="termin-headline">Erstgespräch vereinbaren.</h2>
      </div>
      <div class="termin-points reveal">
        <div class="termin-point">
          <div class="termin-point-value nums">30 Min</div>
          <div class="termin-point-label">Dauer</div>
        </div>
        <div class="termin-point">
          <div class="termin-point-value">Kostenfrei</div>
          <div class="termin-point-label">Investition</div>
        </div>
        <div class="termin-point">
          <div class="termin-point-value">Online</div>
          <div class="termin-point-label">Format</div>
        </div>
      </div>

      <div class="cal-direct reveal">
        <a
          href="https://cal.eu/proimma/30min"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary"
          data-cta="termin-direktlink"
        >Termin auf cal.eu öffnen</a>
        <p class="cal-direct-help">Die Buchungsmaske öffnet sich in einer neuen Ansicht auf cal.eu.</p>
      </div>

      <p class="termin-fallback">Falls Sie lieber direkt schreiben oder anrufen möchten: <a href="mailto:info@proimma.de" data-cta="kontakt-mail">info@proimma.de</a> oder <a href="tel:+491736335917" data-cta="kontakt-tel">0173 6335917</a>.</p>
    </div>
  </section>

</BaseLayout>

<style>
  /* ---------- 01 HERO ----------
     Korrektur 02.05.2026: Hero kompakter, sodass Headline plus Subline plus Button
     auf üblichen Bildschirmen in den ersten Sichtbereich passen. Schrift Maximum
     auf 6.5rem (104 Pixel) reduziert, max-width auf 22ch erweitert, Padding
     reduziert. Reveal-Animation entfällt im Above-the-Fold. */
  .hero { padding-block: 80px 96px; }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 11fr;
    gap: 0;
  }

  .hero-strich,
  .hero-headline,
  .hero-subline,
  .hero-cta { grid-column: 2; }

  .hero-strich .ed-strich { margin-bottom: 32px; }

  .hero-headline {
    font-size: clamp(2.75rem, 6.4vw, 6.5rem); /* 44px Mobile bis 104px Desktop */
    line-height: 1.05;
    font-weight: 300;
    letter-spacing: -0.02em;
    margin-bottom: 40px;
    max-width: 22ch;
    color: var(--color-fg-primary);
    text-wrap: balance;
  }

  .hero-subline {
    font-size: clamp(1.125rem, 1.5vw, 1.5rem); /* 18px Mobile bis 24px Desktop */
    line-height: 1.45;
    font-weight: 300;
    color: var(--color-fg-secondary);
    max-width: 56ch;
    margin-bottom: 48px;
  }

  @media (min-width: 1280px) {
    .hero { padding-block: 96px 112px; }
  }

  @media (max-width: 1024px) {
    /* Korrektur 02.05.2026 (Mobile): Padding nach oben kleiner, sodass die
       Hauptaussage früher im ersten Sichtbereich startet. */
    .hero { padding-block: 56px 80px; }
    .hero-grid { grid-template-columns: 1fr; }
    .hero-strich,
    .hero-headline,
    .hero-subline,
    .hero-cta { grid-column: 1; }
  }

  /* ---------- 02 HERO-DATENPUNKTE ---------- */
  .data {
    padding-block: 96px 144px;
    border-top: 1px solid var(--color-line-faint);
  }

  .data-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
  }

  .data-item {
    padding: 0 40px;
    border-right: 1px solid var(--color-line-faint);
  }
  .data-item:first-child { padding-left: 0; }
  .data-item:last-child {
    padding-right: 0;
    border-right: none;
  }

  .data-strich {
    width: 64px;
    height: 1px;
    background: var(--color-line);
    margin-bottom: 24px;
  }

  .data-value {
    /* Korrekturen 02.05.2026:
       - Schriftgröße reduziert, sodass „1 Werktag" einzeilig steht
         und alle drei Werte optisch auf gleicher Höhe enden.
       - Untergrenze von 32 auf 36 Pixel erhöht für bessere Mobile-Wirkung. */
    font-size: clamp(2.25rem, 3.6vw, 3.5rem); /* 36px Mobile bis 56px Desktop */
    line-height: 1.05;
    font-weight: 300;
    letter-spacing: -0.02em;
    margin-bottom: 16px;
    white-space: nowrap;
  }

  .data-label {
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-fg-secondary);
    margin-bottom: 24px;
  }

  .data-text {
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-fg-secondary);
    max-width: 36ch;
  }

  @media (max-width: 1024px) {
    /* Korrektur 02.05.2026 (Mobile): Padding nach unten kleiner, weil der
       Übergang vom dritten Datenpunkt § 34c zum Verzichtsblock sonst
       zu viel Leerraum hat. */
    .data { padding-block: 64px 48px; }
    .data-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .data-item {
      padding: 0;
      border-right: none;
      border-bottom: 1px solid var(--color-line-faint);
      padding-bottom: 40px;
    }
