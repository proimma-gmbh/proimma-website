---
// Detail-Seite Kontakt — Editorial Bold
// Stand 03.05.2026, Phase 2 Bau-Block 6.
//
// Quelle eins-zu-eins (Verbot 7 strikt):
//   09_Kontakt_2026-04-28.md
//
// Soll-Stack laut Bauauftrag Phase 2 bis 4 Stufe 3:
//   01 Editorial-Hero
//   02 Drei Kontakt-Wege Klartext (Telefon mit data-cta="kontakt-tel",
//      E-Mail mit data-cta="kontakt-mail", Online-Buchung mit
//      data-cta="erstgespraech-cta-detail"); Erreichbarkeits-Wortlaut
//   03 Cal.eu-iFrame-Block als zentrale Termin-Buchungs-Sektion
//   04 Footer (über BaseLayout)

import BaseLayout from '@/layouts/BaseLayout.astro';
import CalEmbed from '@/components/CalEmbed.astro';

const title = 'Kontakt';
const description = 'Drei Wege, mit Proimma in Verbindung zu treten: Telefon, E-Mail oder Online-Buchung eines Erstgesprächs im Cal.com-Kalender. Werktags 9 bis 17 Uhr in Rostock.';
// Seitenspezifisches OG-Bild, Stand 06.05.2026.
const ogImage = '/og-images/og-kontakt.png';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Startseite', item: 'https://www.proimma.de/' },
    { '@type': 'ListItem', position: 2, name: 'Kontakt', item: 'https://www.proimma.de/kontakt' },
  ],
};
---

<BaseLayout title={title} description={description} ogImage={ogImage} pageSchema={breadcrumbSchema}>

  <!-- 01 EDITORIAL-HERO -->
  <section class="hero-detail" data-sektion="hero-kontakt">
    <div class="container-page hero-detail-grid">
      <div class="hero-detail-strich"><div class="ed-strich"></div></div>
      <div class="ed-index">01 Kontakt</div>
      <h1 class="hero-detail-headline">Kontakt</h1>
      <p class="hero-detail-subline">Drei Wege, mit Proimma in Verbindung zu treten: Telefon, E-Mail oder die Online-Buchung eines Erstgesprächs in unserem Cal.com-Kalender. Sie wählen den Weg, der zu Ihrer Anfrage passt.</p>
    </div>
  </section>

  <!-- 02 DREI KONTAKT-WEGE plus Erreichbarkeit plus Direkter Ansprechpartner -->
  <section class="section-block" data-sektion="kontakt-wege">
    <div class="container-page section-grid">
      <div class="section-meta reveal"><div class="ed-index">02 Wege</div></div>
      <div class="section-content reveal">
        <ol class="wege-list">
          <li class="weg-row">
            <span class="weg-num nums">01</span>
            <div>
              <div class="weg-name">Telefon</div>
              <p class="weg-text"><a href="tel:+491736335917" data-cta="kontakt-tel" class="weg-link">0173-6335917</a></p>
            </div>
          </li>
          <li class="weg-row">
            <span class="weg-num nums">02</span>
            <div>
              <div class="weg-name">E-Mail</div>
              <p class="weg-text"><a href="mailto:info@proimma.de" data-cta="kontakt-mail" class="weg-link">info@proimma.de</a></p>
            </div>
          </li>
          <li class="weg-row">
            <span class="weg-num nums">03</span>
            <div>
              <div class="weg-name">Online-Buchung</div>
              <p class="weg-text">Erstgespräch in unserem Cal.com-Kalender, eingebettet weiter unten auf dieser Seite.</p>
            </div>
          </li>
        </ol>

        <h2 class="sub-headline">Adresse</h2>
        <p class="weg-text">Proimma GmbH, Bremer Straße 12, 18057 Rostock.</p>

        <h2 class="sub-headline">Erreichbarkeit</h2>
        <p class="weg-text">Bürozeit Montag bis Freitag von 9 bis 17 Uhr. Auf Anfragen erhalten Sie eine erste Rückmeldung innerhalb eines Werktages. Wenn eine Antwort mehr Zeit braucht, weil eine Frage tiefer abgeklärt werden muss, sagen wir Ihnen das ausdrücklich und nennen einen realistischen Termin.</p>

        <h2 class="sub-headline">Direkter Ansprechpartner und Mieter-Notfälle</h2>
        <p class="weg-text">Eigentümer-Anliegen landen direkt bei André Dieckmann als Inhaber, ohne Sachbearbeiter-Ebene und ohne Weiterleitung über mehrere Mitarbeiter.</p>
        <p class="weg-text">Für Mieter-Notfälle wie Rohrbruch, Heizungsausfall, Stromausfall oder Sicherheitsvorfall besteht eine separate Notfall-Erreichbarkeit. Bei einem konkreten Verwaltungsmandat ist die zuständige Notfall-Nummer im Mieterportal hinterlegt und allen Mietern Ihres Objekts bekannt.</p>

        <h2 class="sub-headline">Rechtlicher Rahmen</h2>
        <p class="weg-text">Die vollständigen Stamm-Daten der Proimma GmbH einschließlich Handelsregister-Eintrag, Steuernummer, Umsatzsteuer-Identifikationsnummer, Aktenzeichen der einheitlichen § 34c-Erlaubnis und Angaben zur Vermögensschadenhaftpflichtversicherung finden Sie im <a href="/impressum" class="weg-link">Impressum</a>.</p>
      </div>
    </div>
  </section>

  <!-- 03 CAL.EU-iFRAME als zentrale Termin-Buchungs-Sektion -->
  <CalEmbed edIndex="03 Erstgespräch" mountId="cal-mount-kontakt" />

</BaseLayout>

<style>
  .hero-detail { padding-block: 96px 144px; }
  .hero-detail-grid {
    display: grid;
    grid-template-columns: 1fr 11fr;
  }
  .hero-detail-strich,
  .hero-detail .ed-index,
  .hero-detail-headline,
  .hero-detail-subline { grid-column: 2; }
  .hero-detail-strich .ed-strich { margin-bottom: 32px; }
  .hero-detail .ed-index { margin-bottom: 24px; }
  .hero-detail-headline {
    font-size: clamp(3rem, 7vw, 7rem);
    line-height: 1.05;
    font-weight: 300;
    letter-spacing: -0.02em;
    margin-bottom: 32px;
    color: var(--color-fg-primary);
  }
  .hero-detail-subline {
    font-size: clamp(1.125rem, 1.5vw, 1.5rem);
    line-height: 1.45;
    font-weight: 300;
    color: var(--color-fg-secondary);
    max-width: 56ch;
  }
  @media (max-width: 1024px) {
    .hero-detail { padding-block: 56px 80px; }
    .hero-detail-grid { grid-template-columns: 1fr; }
    .hero-detail-strich,
    .hero-detail .ed-index,
    .hero-detail-headline,
    .hero-detail-subline { grid-column: 1; }
  }

  .section-block {
    padding-block: 144px;
    border-top: 1px solid var(--color-line-faint);
  }
  .section-grid {
    display: grid;
    grid-template-columns: 4fr 8fr;
    gap: 80px;
    align-items: start;
  }
  .section-meta { position: sticky; top: 120px; }
  .wege-list { list-style: none; padding: 0; margin: 0 0 64px 0; }
  .weg-row {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 32px;
    padding-block: 32px;
    border-top: 1px solid var(--color-line);
  }
  .weg-row:last-child { border-bottom: 1px solid var(--color-line); }
  .weg-num {
    font-size: 0.875rem; font-weight: 500; letter-spacing: 0.18em;
    color: var(--color-accent); padding-top: 8px;
  }
  .weg-name {
    font-size: 1.375rem; font-weight: 500; line-height: 1.3;
    color: var(--color-fg-primary);
  }
  .weg-text {
    font-size: 1.0625rem; line-height: 1.65;
    color: var(--color-fg-secondary);
    margin: 12px 0 0 0;
    max-width: 62ch;
  }
  .weg-link {
    color: var(--color-fg-primary);
    border-bottom: 1px solid var(--color-line);
  }
  .weg-link:hover { border-bottom-color: var(--color-fg-primary); }
  .sub-headline {
    font-size: 1.125rem; font-weight: 500;
    color: var(--color-fg-primary);
    margin: 48px 0 12px 0;
    letter-spacing: -0.005em;
  }
  @media (max-width: 1024px) {
    .section-block { padding-block: 80px; }
    .section-grid { grid-template-columns: 1fr; gap: 32px; }
    .section-meta { position: static; }
  }
</style>
