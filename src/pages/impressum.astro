---
// Detail-Seite Impressum — Editorial Bold
// Stand 03.05.2026, Phase 2 Bau-Block 6.
//
// Quelle eins-zu-eins (Verbot 7 strikt):
//   10_Impressum_2026-04-28.md
//
// Pflichtwortlaute auf dieser Seite (Bauauftrag Sektion Pflichtwortlaute):
//   - § 34c Absatz 1 Satz 1 Nummer 1 und Nummer 4 GewO der Hansestadt Rostock
//   - Aktenzeichen gew-1270-2024-AD3231 (NUR hier sichtbar; nirgends sonst)
//   - Ausstellungsdatum 31.03.2026
//   - Police-Daten: andsafe AG, 2.000.000 Euro pauschal je Versicherungsfall,
//     Jahreshöchstentschädigung das Zweifache, weltweiter Geltungsbereich
//   - § 18 Absatz 2 MStV: André Dieckmann verantwortlich
// ODR-Plattform-Verweis am 05.05.2026 (v25-Compliance) ersatzlos gestrichen,
// weil die EU-ODR-Plattform am 20.07.2025 eingestellt wurde.

import BaseLayout from '@/layouts/BaseLayout.astro';

const title = 'Impressum';
const description = 'Impressum der Proimma GmbH, Bremer Straße 12, 18057 Rostock. Geschäftsführer André Dieckmann, Handelsregister HRB 16077, USt-IdNr DE359185515.';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Startseite', item: 'https://www.proimma.de/' },
    { '@type': 'ListItem', position: 2, name: 'Impressum', item: 'https://www.proimma.de/impressum' },
  ],
};
---

<BaseLayout title={title} description={description} pageSchema={breadcrumbSchema}>

  <section class="hero-rechts" data-sektion="hero-impressum">
    <div class="container-page">
      <div class="ed-strich" style="margin-bottom: 32px;"></div>
      <div class="ed-index">Impressum</div>
      <h1 class="rechts-headline">Impressum</h1>
    </div>
  </section>

  <article class="rechts-text container-page" data-sektion="impressum-text">

    <h2>Anbieter</h2>
    <p>
      Proimma GmbH<br />
      Bremer Straße 12<br />
      18057 Rostock
    </p>

    <h2>Geschäftsführer</h2>
    <p>André Dieckmann, alleinvertretungsberechtigt</p>

    <h2>Kontakt</h2>
    <p>
      Telefon: <a href="tel:+491736335917" data-cta="kontakt-tel">0173-6335917</a><br />
      E-Mail: <a href="mailto:info@proimma.de" data-cta="kontakt-mail">info@proimma.de</a>
    </p>

    <h2>Handelsregister</h2>
    <p>Amtsgericht Rostock, HRB 16077</p>

    <h2>Umsatzsteuer-Identifikationsnummer</h2>
