---
// Wissens-Übersicht — Editorial Bold
// Stand 03.05.2026, Phase 4 Bau-Block 6.
//
// Quelle eins-zu-eins (Verbot 7 strikt):
//   11_Themen-Hub-Uebersicht_Wissen-fuer-Eigentuemer_2026-04-28.md
//
// Soll-Stack:
//   01 Editorial-Hero
//   02 Editorial-Karten-Übersicht mit allen vier Erstartikeln
//      (im Gegensatz zur Startseiten-Vorschau mit drei Karten)
//   03 Was als Nächstes kommt
//   04 Footer (über BaseLayout)
//
// BreadcrumbList-Schema. Pillar-Seite der Wissens-Cluster-Architektur,
// Anker-Texte sachlich-beschreibend.

import BaseLayout from '@/layouts/BaseLayout.astro';

const title = 'Wissen für Eigentümer';
const description = 'Sachlich aufbereitete Beiträge zu Hausverwaltung und Maklerei für Eigentümer in Rostock. Verwalterwechsel, Bestandsübergabe, Maklerprovision nach § 656c BGB, Verkauf einer Wohnimmobilie.';
// Seitenspezifisches OG-Bild gemäß BRIEFS.md Sektion 1.6 bis 1.10 (Editorial-Index 06,
// Themen-Hub-Übersicht). Stand 06.05.2026.
const ogImage = '/og-images/og-themen-hub.png';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Startseite', item: 'https://www.proimma.de/' },
    { '@type': 'ListItem', position: 2, name: 'Wissen für Eigentümer', item: 'https://www.proimma.de/wissen' },
  ],
};

const artikel = [
  {
    nummer: '01',
    titel: 'Was Eigentümer beim Wechsel der Hausverwaltung prüfen sollten',
    anriss: 'Ein Verwalterwechsel ist eine Entscheidung mit Folgen für die nächsten mehreren Jahre. Der Beitrag ordnet ein, was Sie vor einer Anfrage selbst klären, welche rechtlichen Mindeststandards eine Hausverwaltung erfüllen muss, welche sechs Punkte im Erstgespräch zählen, welche vier Signale Sie aufmerken lassen sollten und wie eine seriöse Übergabe abläuft.',
    leseDauer: '7 min',
    href: '/wissen/verwalterwechsel',
  },
  {
    nummer: '02',
    titel: 'Wie eine saubere Bestandsübergabe kaufmännisch und technisch abläuft',
    anriss: 'Die Übergabe ist der eigentliche Lackmus-Test einer Hausverwaltungsbeziehung. Der Beitrag beschreibt die Stichtag-Logik und führt die zwei Stränge der Übergabe einzeln durch: kaufmännisch mit Mietverträgen, offenen Posten, Mietkautionen und Betriebskosten, technisch mit Plänen, Wartungen, Schlüssellisten und Zustandsdokumentation. Zusätzlich: was zu tun ist, wenn die Vor-Verwaltung nicht kooperiert.',
    leseDauer: '6 min',
    href: '/wissen/bestandsuebergabe',
  },
  {
    nummer: '03',
    titel: 'Wie die Maklerprovision nach § 656c BGB konkret gerechnet wird',
    anriss: 'Seit Ende 2020 regelt § 656c BGB die Verteilung der Maklerprovision beim Kauf von Eigentumswohnungen und Einfamilienhäusern. Der Beitrag erklärt das Provisionsteilungsgebot, die Verbraucher-Definition nach § 13 BGB, die konkrete Rechnung mit 7,14 Prozent inklusive Mehrwertsteuer hälftig geteilt zwischen Verkäufer und Käufer, die Fälligkeitsregeln und die Posten, die nicht in der Maklerprovision enthalten sind.',
    leseDauer: '5 min',
    href: '/wissen/maklerprovision',
  },
  {
    nummer: '04',
    titel: 'Was Eigentümer beim Verkauf einer Wohnimmobilie in Rostock realistischerweise erwarten dürfen',
    anriss: 'Ein Immobilienverkauf ist ein Prozess in mehreren Phasen, kein Termin. Der Beitrag ordnet die Phasen ein, beschreibt sinnvoll vorzubereitende Unterlagen, die Mechanik der Vermarktungs- und Beurkundungsphase, die zwei typischen Posten auf Verkäuferseite und drei häufige Fehlannahmen, die im Markt kursieren.',
    leseDauer: '6 min',
    href: '/wissen/verkauf-wohnimmobilie',
  },
];
---

<BaseLayout title={title} description={description} ogImage={ogImage} pageSchema={breadcrumbSchema}>

  <!-- 01 EDITORIAL-HERO -->
  <section class="hero-detail" data-sektion="hero-wissen">
    <div class="container-page hero-detail-grid">
      <div class="hero-detail-strich"><div class="ed-strich"></div></div>
      <div class="ed-index">Wissen für Eigentümer</div>
      <h1 class="hero-detail-headline">Wissen für Eigentümer.</h1>
      <p class="hero-detail-subline">Eigentümer treffen Entscheidungen, bei denen Tempo, Mechanik und Vertragsdetails über Jahre hinweg nachwirken. Diese Wissens-Sektion sammelt Beiträge, die einzelne Themen aus der Praxis von Hausverwaltung und Maklerei sachlich aufbereiten. Die Texte sind nüchtern geschrieben, prüfbar in den Aussagen und ohne Werbeformeln. Die Sektion wächst mit jedem neuen Beitrag.</p>
    </div>
  </section>

  <!-- 02 VIER ERSTARTIKEL als Editorial-Karten -->
  <section class="artikel-uebersicht" data-sektion="wissen-artikel">
    <div class="container-page">
      <div class="uebersicht-head reveal">
        <div class="ed-index">Vier Beiträge zum Auftakt</div>
        <h2 class="uebersicht-headline">Vier Beiträge zum Auftakt.</h2>
      </div>
      <ol class="artikel-list reveal">
        {artikel.map((a) => (
          <li>
            <a href={a.href} class="artikel-item" data-cta={`wissen-${a.nummer}`}>
              <span class="artikel-num nums">{a.nummer}</span>
              <div class="artikel-body">
                <h3 class="artikel-title">{a.titel}</h3>
                <p class="artikel-anriss">{a.anriss}</p>
              </div>
              <span class="artikel-meta nums">{a.leseDauer}</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 03 WAS ALS NÄCHSTES KOMMT -->
  <section class="naechstes" data-sektion="wissen-naechstes">
    <div class="container-page section-grid">
      <div class="section-meta reveal"><div class="ed-index">Ausblick</div></div>
      <div class="section-content reveal">
        <h2 class="section-headline">Was als Nächstes kommt:</h2>
        <div class="section-body">
          <p>Diese Sektion wächst. Geplant sind weitere Beiträge zu Themen aus Mietenverwaltung und Maklerei. Wenn Sie ein Thema vermissen, das Sie als Eigentümer beschäftigt, schreiben Sie an <a href="mailto:info@proimma.de" data-cta="kontakt-mail" class="inline-link">info@proimma.de</a>.</p>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .hero-detail { padding-block: 96px 144px; }
  .hero-detail-grid {
    display: grid;
    grid-template-columns: 1fr 11fr;
  }
  .hero-detail-strich,
  .hero-detail .ed-index,
  .hero-detail-headline,
  .hero-detail-subline { grid-column: 2; }
  .hero-detail-strich .ed-strich { margin-bottom: 32px; }
  .hero-detail .ed-index { margin-bottom: 24px; }
  .hero-detail-headline {
    font-size: clamp(2.75rem, 6.4vw, 6rem);
    line-height: 1.05;
    font-weight: 300;
    letter-spacing: -0.02em;
    margin-bottom: 32px;
    max-width: 14ch;
    color: var(--color-fg-primary);
    text-wrap: balance;
  }
  .hero-detail-subline {
    font-size: clamp(1.0625rem, 1.4vw, 1.25rem);
    line-height: 1.55;
    font-weight: 300;
    color: var(--color-fg-secondary);
    max-width: 64ch;
  }
  @media (max-width: 1024px) {
    .hero-detail { padding-block: 56px 80px; }
    .hero-detail-grid { grid-template-columns: 1fr; }
    .hero-detail-strich,
    .hero-detail .ed-index,
    .hero-detail-headline,
    .hero-detail-subline { grid-column: 1; }
  }

  .artikel-uebersicht {
    padding-block: 144px;
    border-top: 1px solid var(--color-line-faint);
  }
  .uebersicht-head { margin-bottom: 64px; max-width: 32ch; }
  .uebersicht-headline {
    font-size: clamp(2rem, 3.5vw, 3rem);
    line-height: 1.1;
    font-weight: 300;
    letter-spacing: -0.025em;
    color: var(--color-fg-primary);
    margin-top: 16px;
  }
  .artikel-list { list-style: none; padding: 0; margin: 0; }
  .artikel-item {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 48px;
    padding-block: 40px;
    border-top: 1px solid var(--color-line);
    align-items: start;
    transition: padding-left 0.3s ease, border-color 0.3s ease;
  }
  .artikel-list li:last-child .artikel-item { border-bottom: 1px solid var(--color-line); }
  .artikel-item:hover {
    padding-left: 16px;
    border-top-color: var(--color-fg-primary);
  }
  .artikel-item:hover + li .artikel-item {
    border-top-color: var(--color-fg-primary);
  }
  .artikel-item:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }
  .artikel-num {
    font-size: 0.875rem; font-weight: 500; letter-spacing: 0.18em;
    color: var(--color-accent); padding-top: 8px;
  }
  .artikel-title {
    font-size: clamp(1.375rem, 2vw, 1.875rem);
    line-height: 1.2;
    font-weight: 400;
    letter-spacing: -0.015em;
    color: var(--color-fg-primary);
    margin: 0;
    text-wrap: balance;
  }
  .artikel-anriss {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-fg-secondary);
    margin-top: 14px;
    max-width: 64ch;
  }
  .artikel-meta {
    font-size: 0.8125rem; font-weight: 500; letter-spacing: 0.06em;
    color: var(--color-fg-secondary); padding-top: 12px;
  }

  .naechstes {
    padding-block: 144px;
    border-top: 1px solid var(--color-line-faint);
  }
  .section-grid {
    display: grid;
    grid-template-columns: 4fr 8fr;
    gap: 80px;
    align-items: start;
  }
  .section-meta { position: sticky; top: 120px; }
  .section-headline {
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    line-height: 1.1;
    font-weight: 300;
    color: var(--color-fg-primary);
    margin-bottom: 24px;
  }
  .section-body {
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--color-fg-secondary);
    max-width: 62ch;
  }
  .inline-link {
    color: var(--color-fg-primary);
    border-bottom: 1px solid var(--color-line);
  }
  .inline-link:hover { border-bottom-color: var(--color-fg-primary); }

  @media (max-width: 1024px) {
    .artikel-uebersicht { padding-block: 80px; }
    .artikel-item {
      grid-template-columns: auto 1fr;
      gap: 24px;
    }
    .artikel-meta {
      grid-column: 2;
      padding-top: 0;
    }
    .naechstes { padding-block: 80px; }
    .section-grid { grid-template-columns: 1fr; gap: 32px; }
    .section-meta { position: static; }
  }
</style>
