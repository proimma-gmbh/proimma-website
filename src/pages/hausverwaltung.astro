---
// Detail-Seite Hausverwaltung — Editorial Bold
// Stand 03.05.2026, Phase 2 Bau-Block 6.
//
// Quellen eins-zu-eins (Verbot 7 strikt):
//   01_Hausverwaltung_2026-04-27.md
//   13_Anleitung-Verwalterwechsel-Anmeldung_2026-04-29.md
//
// Soll-Stack laut Bauauftrag Phase 2 bis 4 Stufe 2:
//   01 Editorial-Hero
//   02 Was Mietenverwaltung bei Proimma bedeutet
//   03 Wie wir arbeiten (Leistungsumfang, Eigentümer-Ansprechen)
//   04 Verwalterwechsel-Sequenz (Bestandsaufnahme, Übergabe, Mieter-Information,
//      laufender Betrieb) als Editorial-Sequenz
//   05 Was wir nicht machen
//   06 Pakete-Aussage ohne Preise
//   07 Lead-Magnet "Hausverwalter wechseln. Fünf Schritte als Anleitung." mit
//      Brevo-Anmelde-Formular (Honeypot-Spamschutz, Doppelt-Opt-In)
//   08 Cross-Links auf Wissens-Cluster (Verwalterwechsel, Bestandsübergabe)
//   09 Cal.eu-Termin-Sektion
//   10 Footer (über BaseLayout)
//
// Schema.org pro Seite: Service-Schema "Property Management" plus
// BreadcrumbList. Title sechzig Zeichen, Meta-Description ein- bis sechzig.

import BaseLayout from '@/layouts/BaseLayout.astro';
import CalEmbed from '@/components/CalEmbed.astro';
import CrossLinks from '@/components/CrossLinks.astro';

const title = 'Hausverwaltung Rostock';
const description = 'Mietenverwaltung von Mehrfamilienhäusern und Wohn- und Geschäftshäusern für Eigentümer in Rostock und Umgebung. Inhabergeführt, mit Hausverwalter-Wechsel-Anleitung als kostenloses PDF.';
// Seitenspezifisches OG-Bild, Stand 06.05.2026.
const ogImage = '/og-images/og-hausverwaltung.png';

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': 'https://www.proimma.de/hausverwaltung#service',
  serviceType: 'Property Management',
  name: 'Mietenverwaltung Mehrfamilienhäuser Rostock',
  description: 'Mietenverwaltung von Mehrfamilienhäusern sowie von Wohn- und Geschäftshäusern für private Eigentümer in Rostock und Umgebung.',
  provider: { '@id': 'https://www.proimma.de/#organization' },
  areaServed: [
    { '@type': 'City', name: 'Rostock' },
    {
      '@type': 'GeoCircle',
      geoMidpoint: { '@type': 'GeoCoordinates', latitude: '54.08978', longitude: '12.09865' },
      geoRadius: '100000',
    },
  ],
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Startseite', item: 'https://www.proimma.de/' },
    { '@type': 'ListItem', position: 2, name: 'Hausverwaltung', item: 'https://www.proimma.de/hausverwaltung' },
  ],
};

// Vier Service-Punkte aus 01_Hausverwaltung Sektion "Was im Leistungsumfang
// enthalten ist" plus die Übergabe-Aussage als eigener vierter Punkt.
const leistungen = [
  {
    nummer: '01',
    name: 'Kaufmännische Verwaltung',
    text: 'Sollstellung und laufende Buchung der Mieten, Pflege der Mieterkonten, offene Posten und Mahnwesen, Erstellung der jährlichen Betriebskostenabrechnung mit nachvollziehbarer Aufgliederung jedes Postens, Verwaltung von Mietkautionen mit getrennter Kontenführung auf Wunsch, Mietanpassungen nach Index oder Vergleichsmiete im Rahmen des gesetzlich Zulässigen, Eigentümer-Reporting in einem mit Ihnen festgelegten Rhythmus, vollständige digitale Dokumentenablage in der Verwaltungssoftware Immocloud mit jederzeit zugänglichem Eigentümer- und Mieterportal.',
  },
  {
    nummer: '02',
    name: 'Technische Verwaltung',
    text: 'Annahme und Bearbeitung von Mängelmeldungen, Begleitung größerer Instandsetzungen mit Angebotseinholung und Auftragsbegleitung, Pflege der wiederkehrenden Wartungen und Prüfungen am Objekt, Begehungen nach Vereinbarung. Übergaben und Abnahmen bei Mieterwechseln werden als gesonderte Leistung mit Protokoll und Foto-Dokumentation durchgeführt.',
  },
  {
    nummer: '03',
    name: 'Handwerker und Hausmeister',
    text: 'Bei jeder Mängelmeldung beauftragen wir gezielt ausgewählte Handwerker. Koordinierender Partner für die laufende Hausmeisterarbeit ist ein fester Hausmeisterdienst aus dem Rostocker Umland. Spezialaufträge wählen wir aus dem beruflichen Netzwerk des Inhabers aus und überführen die belastbarsten Kontakte schrittweise in einen festen Dienstleisterpool.',
  },
];

// Vier-Schritte-Sequenz aus 01_Hausverwaltung Sektion "Wie die Übernahme abläuft"
const wechsel = [
  {
    nummer: '01',
    name: 'Bestandsaufnahme',
    text: 'Im ersten Schritt erfassen wir gemeinsam mit Ihnen den Stand des Objekts. Welche Mietverhältnisse bestehen? Welche Verträge laufen? Welcher Pflege- und Reparaturzustand liegt vor? Welche Zahlungsstände stehen offen? Welche Vereinbarungen sind mit Mietern und Dienstleistern getroffen? Dieser Schritt ist nüchterne Bestandsaufnahme, keine Bewertung Ihrer Vor-Verwaltung.',
  },
  {
    nummer: '02',
    name: 'Kaufmännische und technische Übergabe',
    text: 'Im zweiten Schritt fordern wir bei Ihrer bisherigen Verwaltung die vollständigen Unterlagen an und gleichen sie gegen unsere Bestandsaufnahme ab. Mietverträge, Mieterakten, Hausgeldabrechnungen sofern vorhanden, Wartungsverträge, Versicherungsdokumente, Pläne, Energieausweise, Schlüsselbestände. Was fehlt, dokumentieren wir und holen es nach. Erst wenn die Datenlage steht, übernehmen wir den laufenden Betrieb.',
  },
  {
    nummer: '03',
    name: 'Mieter-Information',
    text: 'Im dritten Schritt informieren wir die Mieter Ihres Objekts schriftlich über den Verwalterwechsel. Klar, sachlich, mit den neuen Kontaktwegen und mit der Bitte, ab dem vereinbarten Stichtag die Miete an das neue Konto zu überweisen oder den neuen Lastschriftauftrag zu unterzeichnen. Auch die Notfall-Erreichbarkeit für Mieter wird in dieser Information benannt.',
  },
  {
    nummer: '04',
    name: 'Laufender Betrieb',
    text: 'Im vierten Schritt geht das Objekt in den regulären Verwaltungsbetrieb über. Mietzahlungen laufen über das neue Konto, Mängelmeldungen kommen an unsere Tickets, das Reporting startet im vereinbarten Rhythmus. Der Übergang ist damit nicht ein Stichtag, sondern ein gemeinsamer Pfad über mehrere Wochen.',
  },
];

const verzicht = [
  'Keine Eigentümergemeinschaften aus mehreren Einzeleigentümern.',
  'Keine reinen Gewerbeobjekte.',
  'Keine Mandate, deren Bewirtschaftung sich auf eine kurzfristige Abwicklung beschränkt.',
];
---

<BaseLayout
  title={title}
  description={description}
  ogImage={ogImage}
  pageSchema={[serviceSchema, breadcrumbSchema]}
>

  <!-- 01 EDITORIAL-HERO -->
  <section class="hero-detail" data-sektion="hero-hausverwaltung">
    <div class="container-page hero-detail-grid">
      <div class="hero-detail-strich"><div class="ed-strich"></div></div>
      <div class="ed-index">01 Hausverwaltung</div>
      <h1 class="hero-detail-headline">Mietenverwaltung in Rostock.</h1>
      <p class="hero-detail-subline">Mehrfamilienhäuser sowie Wohn- und Geschäftshäuser. Inhabergeführt mit direktem Ansprechpartner und dokumentiertem Übernahme-Prozess.</p>
      <p class="hero-detail-abgrenzung">Für einzelne Eigentümer vermieteter Mehrfamilienhäuser. Keine Eigentümergemeinschaften.</p>
      <div class="hero-detail-cta">
        <a href="#anfrage" class="btn-primary" data-cta="hero-anfrage">Unverbindlich anfragen</a>
        <a href="https://cal.eu/proimma/30min" target="_blank" rel="noopener noreferrer" class="link-arrow" data-cta="hero-termin">Oder direkt einen Termin wählen</a>
      </div>
    </div>
  </section>

  <!-- 02 WAS MIETENVERWALTUNG BEI PROIMMA BEDEUTET -->
  <section class="section-block" data-sektion="hausverwaltung-bedeutet">
    <div class="container-page section-grid">
      <div class="section-meta reveal">
        <div class="ed-index">02 Auftrag</div>
      </div>
      <div class="section-content reveal">
        <h2 class="section-headline">Was Mietenverwaltung bei Proimma bedeutet:</h2>
        <div class="section-body">
          <p>Proimma übernimmt für Eigentümer in Rostock und Umgebung die Mietenverwaltung von Mehrfamilienhäusern sowie von Wohn- und Geschäftshäusern. Der Auftrag lautet, das Haus als Ganzes wirtschaftlich und technisch zu betreiben. Sie übertragen uns die laufende Verantwortung für das Objekt im vereinbarten Umfang. Wir führen die laufende Bewirtschaftung im Sinne Ihrer Vorgaben.</p>
          <p>Verwaltet werden Substanz und Betrieb des Gebäudes für einen Eigentümer oder eine Eigentümergesellschaft. Sie übergeben uns die laufende Verantwortung im vereinbarten Umfang, wir führen das Objekt im Sinne Ihrer Vorgaben. Bei jedem Auftrag bleibt der Inhaber Ansprechpartner.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 03 WIE WIR ARBEITEN: ZIELGRUPPE PLUS LEISTUNGSUMFANG -->
  <section class="section-block" data-sektion="hausverwaltung-arbeit">
    <div class="container-page section-grid">
      <div class="section-meta reveal">
        <div class="ed-index">03 Wie wir arbeiten</div>
      </div>
      <div class="section-content reveal">
        <h2 class="section-headline">Welche Eigentümer wir ansprechen:</h2>
        <div class="section-body">
          <p>Sie sind Eigentümer eines oder mehrerer Mehrfamilienhäuser vorrangig in Rostock und Umgebung, mit Schwerpunkt im Umkreis von etwa 100 Kilometern? Mandate über diesen Umkreis hinaus übernehmen wir auf Anfrage. Sie halten Ihre Objekte als Kapitalanlage, haben sie geerbt oder im Rahmen einer Objektgesellschaft erworben? Sie suchen einen Verwalter, der nicht nur Buchhaltung und Mieterverwaltung macht, sondern Ihr Objekt mit derselben Aufmerksamkeit führt, mit der Sie es aufgebaut oder übernommen haben?</p>
          <p>Auch Wohn- und Geschäftshäuser mit gemischter Nutzung gehören in unser Aufgabengebiet. Wenn ein Objekt überwiegend Wohnnutzung mit ergänzenden Gewerbeflächen im Erdgeschoss verbindet, ist die Mechanik der Mietenverwaltung dieselbe.</p>
        </div>

        <h3 class="leistungen-headline">Was im Leistungsumfang enthalten ist:</h3>
        <div class="leistungen-list">
          {leistungen.map((item) => (
            <div class="leistung-row">
              <span class="leistung-num nums">{item.nummer}</span>
              <div>
                <div class="leistung-name">{item.name}</div>
                <p class="leistung-text">{item.text}</p>
              </div>
            </div>
          ))}
        </div>

        <h3 class="leistungen-headline" style="margin-top: 64px;">Wie Sie uns erreichen:</h3>
        <div class="section-body">
          <p>Eigentümer-Anliegen landen direkt bei André Dieckmann als Inhaber und Geschäftsführer. Es gibt keine Sachbearbeiter-Ebene, durch die ein Anliegen erst geleitet werden muss, und keine Weiterleitung über mehrere Mitarbeiter. Diese Direktheit ist eine Strukturentscheidung der inhabergeführten Proimma GmbH, kein Übergangszustand der Aufbauphase.</p>
          <p>Auf Eigentümer-Anfragen erhalten Sie eine erste Rückmeldung innerhalb eines Werktages. Wenn eine Rückmeldung mehr Zeit braucht, weil eine Frage tiefer abgeklärt werden muss, sagen wir Ihnen das ausdrücklich und nennen einen realistischen Termin.</p>
          <p>Für Mieter Ihrer Objekte besteht eine separate Notfall-Erreichbarkeit. Rohrbruch, Heizungsausfall, Stromausfall, Sicherheitsvorfall, das sind die Lagen, in denen die reguläre Bürozeit nicht der richtige Maßstab ist. Diese Notfall-Erreichbarkeit ist von der Eigentümer-Erreichbarkeit getrennt, damit Akquise- und Eigentümer-Themen nicht in der Mieter-Hotline untergehen und umgekehrt.</p>
          <p>Reguläre Bürozeit Montag bis Freitag von 9 bis 17 Uhr. Kontaktwege Telefon, E-Mail an info@proimma.de, das Eigentümer- und Mieterportal in der Verwaltungssoftware Immocloud. Termine für Erstgespräche buchen Sie direkt online über unseren Cal.com-Kalender.</p>
        </div>

        <p class="mid-cta">
          <a href="#anfrage" class="link-arrow" data-cta="mitte-anfrage">Ihr Objekt unverbindlich anfragen</a>
        </p>
      </div>
    </div>
  </section>

  <!-- 04 VERWALTERWECHSEL-SEQUENZ (Editorial-Sequenz mit nummerierten Stationen) -->
  <section class="section-block sequenz" data-sektion="hausverwaltung-wechsel-sequenz">
    <div class="container-page section-grid">
      <div class="section-meta reveal">
        <div class="ed-index">04 Wechsel-Sequenz</div>
      </div>
      <div class="section-content reveal">
        <h2 class="section-headline">Wie ein Verwalterwechsel bei Proimma abläuft:</h2>
        <p class="lead">Eine saubere Übernahme entscheidet über die nächsten Jahre. Wir trennen den Prozess in vier klar abgegrenzte Schritte und machen jeden Schritt für Sie nachvollziehbar.</p>
        <ol class="sequenz-list">
          {wechsel.map((step) => (
            <li class="sequenz-row">
              <span class="sequenz-num nums">{step.nummer}</span>
              <div>
                <div class="sequenz-name">{step.name}</div>
                <p class="sequenz-text">{step.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- 05 WAS WIR NICHT MACHEN -->
  <section class="section-block" data-sektion="hausverwaltung-verzicht">
    <div class="container-page section-grid">
      <div class="section-meta reveal">
        <div class="ed-index">05 Verzicht</div>
      </div>
      <div class="section-content reveal">
        <h2 class="section-headline">Was wir nicht machen:</h2>
        <p class="lead">Wir nennen die Aufgaben offen, die wir nicht übernehmen, weil die Klarheit für Sie als Eigentümer wertvoller ist als ein Allesanbieter-Versprechen.</p>
        <ol class="verzicht-list-detail">
          {verzicht.map((text, idx) => (
            <li class="verzicht-row-detail">
              <span class="verzicht-num-detail nums">{String(idx + 1).padStart(2, '0')}</span>
              <span class="verzicht-text-detail">{text}</span>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- 06 PAKETE OHNE PREISE
       Externe Kommunikationsregel: keine Pakete-Namen LIGHT/BASIS/PLUS/PREMIUM,
       stattdessen "individuelles Angebot nach Objektgröße und Leistungsumfang". -->
  <section class="section-block" data-sektion="hausverwaltung-pakete">
    <div class="container-page section-grid">
      <div class="section-meta reveal">
        <div class="ed-index">06 Angebot</div>
      </div>
      <div class="section-content reveal">
        <h2 class="section-headline">Wie ein Erstgespräch bei uns aussieht:</h2>
        <div class="section-body">
          <p>Im Erstgespräch beginnen wir bei Ihrem Objekt und Ihrer Situation. Wir hören zu, fragen das Wesentliche ab, ordnen ein, was machbar ist und was nicht. Erst nach dieser Bestandsaufnahme bekommen Sie ein individuelles Angebot nach Objektgröße und Leistungsumfang. Wir nennen keine pauschalen Preisspannen im Erstgespräch, weil pauschale Preise vom konkreten Aufwand wegführen und Ihnen nicht helfen.</p>
          <p>Für die Tätigkeit als Wohnimmobilienverwalter besteht nach § 15 MaBV die Pflicht zur Vermögensschadenhaftpflicht-Versicherung. Die einheitliche gewerberechtliche Erlaubnis nach § 34c Absatz 1 Satz 1 Nummer 1 und Nummer 4 GewO wurde der Proimma GmbH durch die Hanse- und Universitätsstadt Rostock am 31.03.2026 erteilt.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 07 ANFRAGE-FORMULAR (PRIMÄRER KONTAKTWEG)
       Direkte Eigentümer-Anfrage ohne Seitenwechsel. Anbindung über ein
       eigenes Brevo-Formular (offizieller Einbettungs-Code, Variante HTML),
       analog zum Anleitungs-Formular in Sektion 08. Pflichtfelder nur Vorname,
       Nachname, E-Mail-Adresse. Freiwillig Telefonnummer, Objekt mit ungefährer
       Anzahl Wohnungen, kurze Nachricht. Kein Doppel-Opt-In (André-Entscheidung
       08.06.2026): die Anfrage geht sofort an info@proimma.de. Optik wird per
       .anfrage-brevo-Überlagerung in die Editorial-Bold-Linie geführt.
       EINBAU-STELLE: Der Brevo-Einbettungs-Code wird in den mit data-brevo-slot
       markierten Container eingesetzt, sobald er vorliegt. -->
  <section class="anfrage-form" id="anfrage" data-sektion="anfrage-formular">
    <div class="container-page section-grid">
      <div class="section-meta reveal">
        <div class="ed-index">07 Anfrage</div>
      </div>
      <div class="section-content reveal">
        <h2 class="section-headline">Ihr Objekt unverbindlich anfragen:</h2>
        <div class="section-body">
          <p>Sie besitzen ein vermietetes Mehrfamilienhaus in Rostock und Umgebung und denken über eine Verwaltung oder einen Verwalterwechsel nach? Schreiben Sie uns kurz. Ein paar Angaben genügen, alles Weitere klären wir im Gespräch.</p>
        </div>

        <p class="anfrage-vertrauen">Kostenlos und unverbindlich. Ihre erste Rückmeldung erhalten Sie innerhalb eines Werktages. Ihr Anliegen landet direkt bei André Dieckmann als Inhaber, ohne Umweg über eine Sachbearbeitung.</p>
        <p class="anfrage-abgrenzung">Wir verwalten vermietete Mehrfamilienhäuser einzelner Eigentümer. Eigentümergemeinschaften (WEG) verwalten wir nicht.</p>

        <!-- Brevo-Anbindung Anfrageformular (Anfrage-Strecke 08.06.2026). Offizieller
             HTML-Einbettungs-Code aus dem Brevo-Konto, Schritt 6 Teilen, Variante
             „HTML", Brevo-Formular „Anfrage Hausverwaltung". Brevos Skript main.js
             (einmal am Seitenende geladen) bindet dieses Formular, weil es als
             einziges #sib-form auf der Seite steht; das Anleitungs-Formular in
             Sektion 08 läuft isoliert als eingebettetes Fenster. Kein Doppel-Opt-In;
             die Anfrage landet ohne Zwischenschritt in der Brevo-Liste „Anfragen
             Hausverwaltung" (André-Entscheidung 08.06.2026: keine automatische Mail,
             weil das kostenlose Brevo das nicht leistet; Erfolgskriterium des Tests
             ist das Ankommen in dieser Liste).
             Brevos Standard-Titel- und Beschreibungs-Blöcke entfernt, sichtbare
             Texte in die Sie-Form überführt; Feld-Namen (VORNAME, NACHNAME, EMAIL,
             TELEFON, OBJEKT, NACHRICHT), Absende-Adresse und Honeypot
             (email_address_check) unverändert aus dem Brevo-Code übernommen.
             Optik per .anfrage-brevo-Überlagerung im Style-Block. Plausible-Ziel
             „Anfrage" am Absende-Knopf über die tagged-events-Klasse. -->
        <link rel="stylesheet" href="https://sibforms.com/forms/end-form/build/sib-styles.css" />

        <div class="sib-form anfrage-brevo">
          <div id="sib-form-container" class="sib-form-container">
            <div id="error-message" class="sib-form-message-panel" style="font-family:Helvetica, sans-serif; font-size:16px; text-align:left; color:#661d1d; background-color:#ffeded; border-color:#ff4949; border-radius:3px; max-width:540px;">
              <div class="sib-form-message-panel__text sib-form-message-panel__text--center">
                <span class="sib-form-message-panel__inner-text">Ihre Anfrage konnte nicht gesendet werden. Bitte versuchen Sie es in einigen Minuten erneut oder erreichen Sie uns werktags unter 0173 6335917 oder per Mail an info@proimma.de.</span>
              </div>
            </div>
            <div></div>
            <div id="success-message" class="sib-form-message-panel" style="font-family:Helvetica, sans-serif; font-size:16px; text-align:left; color:#085229; background-color:#e7faf0; border-color:#13ce66; border-radius:3px; max-width:540px;">
              <div class="sib-form-message-panel__text sib-form-message-panel__text--center">
                <span class="sib-form-message-panel__inner-text">Vielen Dank für Ihre Anfrage. Ihre Nachricht ist bei uns eingegangen, wir melden uns innerhalb eines Werktages bei Ihnen.</span>
              </div>
            </div>
            <div></div>
            <div id="sib-container" class="sib-container--large sib-container--vertical" style="max-width:540px; text-align:center; background-color:rgba(255,255,255,1); border-width:1px; border-style:solid; border-color:#C0CCD9; border-radius:3px; direction:ltr">
              <form id="sib-form" method="POST" action="https://b596ced0.sibforms.com/serve/MUIFABal07w7-P81M2bBeVkPTmb8Lth4xLq0lBenQPpyugTC7Y4jrr9ncfrFoo5iBSB9ITKIUahmb8VVvM549S-QFTIFGfBuFc4IjzHnIC02mYJD4GA8HohwpyQVhTlwS6HIcJE5W9NpiVnkThJzmeOzSRK15xEzmlGFDGLVe89LbBN6w9AeqkQZA1ROUTcLwRCl3B7NXrHLxMufGA==" data-type="subscription">
                <div style="padding: 8px 0;">
                  <div class="sib-input sib-form-block">
                    <div class="form__entry entry_block">
                      <div class="form__label-row">
                        <label class="entry__label" style="font-weight:700; font-family:Helvetica, sans-serif; font-size:16px; text-align:left; color:#3c4858;" for="VORNAME" data-required="*">Vorname</label>
                        <div class="entry__field">
                          <input class="input" maxlength="200" type="text" id="VORNAME" name="VORNAME" autocomplete="given-name" placeholder="" data-required="true" required />
                        </div>
                      </div>
                      <label class="entry__error entry__error--primary" style="font-family:Helvetica, sans-serif; font-size:16px; text-align:left; color:#661d1d; background-color:#ffeded; border-color:#ff4949; border-radius:3px;"></label>
                    </div>
                  </div>
                </div>
                <div style="padding: 8px 0;">
                  <div class="sib-input sib-form-block">
                    <div class="form__entry entry_block">
                      <div class="form__label-row">
                        <label class="entry__label" style="font-weight:700; font-family:Helvetica, sans-serif; font-size:16px; text-align:left; color:#3c4858;" for="NACHNAME">Nachname (freiwillig)</label>
                        <div class="entry__field">
                          <input class="input" maxlength="200" type="text" id="NACHNAME" name="NACHNAME" autocomplete="family-name" placeholder="" />
                        </div>
                      </div>
                      <label class="entry__error entry__error--primary" style="font-family:Helvetica, sans-serif; font-size:16px; text-align:left; color:#661d1d; background-color:#ffeded; border-color:#ff4949; border-radius:3px;"></label>
                    </div>
                  </div>
                </div>
                <div style="padding: 8px 0;">
                  <div class="sib-input sib-form-block">
                    <div class="form__entry entry_block">
                      <div class="form__label-row">
                        <label class="entry__label" style="font-weight:700; font-family:Helvetica, sans-serif; font-size:16px; text-align:left; color:#3c4858;" for="EMAIL" data-required="*">E-Mail-Adresse</label>
                        <div class="entry__field">
