---
// Cal.eu-Termin-Sektion — Editorial Bold
// Stand 03.05.2026, Phase 2 Bau-Block 6.
// Phase-1b dritte Stufe 12.05.2026: iFrame-Einbettung komplett entfernt.
// Begründung: moderne Chrome-Varianten blockieren den Cal.eu-iframe wegen
// Drittanbieter-Cookie-Schutz und zeigen statt der Termin-Maske eine graue
// Block-Box. Auch die Zwei-Klick-Lazy-Load-Pattern-Variante ändert daran
// nichts. Daher wird auf jeder Sektion ausschließlich ein Direkt-Link-Button
// angezeigt, der cal.eu/proimma/30min in einer neuen Browser-Ansicht öffnet.
// Vorteil: konsistente Anzeige auf jedem Gerät und in jedem Browser,
// keine Block-Box. Datenschutz-Anpassung der Cal.com-iframe-Passage in
// der Datenschutzerklärung als Klein-Pendenz für den späteren Folge-Auftrag.
//
// Wiederverwendbare Termin-Buchungs-Sektion für die Detail-Seiten
// /hausverwaltung, /maklerei, /ueber-proimma und /kontakt. Auf der
// Startseite ist der Termin-Block direkt in index.astro umgesetzt.

interface Props {
  /** Editorial-Index der Sektion auf der jeweiligen Seite. */
  edIndex: string;
}

const { edIndex } = Astro.props;
---

<section class="termin termin-detail" id="kontakt" data-sektion="cal-embed">
  <div class="container-page termin-inner">
    <div class="termin-head reveal">
      <div class="ed-index">{edIndex}</div>
      <h2 class="termin-headline">Erstgespräch vereinbaren.</h2>
    </div>
    <div class="termin-points reveal">
      <div class="termin-point">
        <div class="termin-point-value nums">30 Min</div>
        <div class="termin-point-label">Dauer</div>
      </div>
      <div class="termin-point">
        <div class="termin-point-value">Kostenfrei</div>
        <div class="termin-point-label">Investition</div>
      </div>
      <div class="termin-point">
        <div class="termin-point-value">Online</div>
        <div class="termin-point-label">Format</div>
      </div>
    </div>

    <div class="cal-direct reveal">
      <a
        href="https://cal.eu/proimma/30min"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-primary"
        data-cta="termin-direktlink"
      >Termin auf cal.eu öffnen</a>
      <p class="cal-direct-help">Die Buchungsmaske öffnet sich in einer neuen Ansicht auf cal.eu.</p>
    </div>

    <p class="termin-fallback">
      Falls Sie lieber direkt schreiben oder anrufen möchten:
      <a href="mailto:info@proimma.de" data-cta="kontakt-mail">info@proimma.de</a>
      oder
      <a href="tel:+491736335917" data-cta="kontakt-tel">0173 6335917</a>.
      Eine erste Rückmeldung erhalten Sie innerhalb eines Werktages.
    </p>
    <p class="termin-cta-row">
      <a href="/kontakt" class="link-arrow" data-cta="erstgespraech-cta-detail">Zur Kontakt-Seite</a>
    </p>
  </div>
</section>

<style>
  .termin-detail {
    padding-block: 144px;
    border-top: 1px solid var(--color-line-faint);
    background: var(--color-bg-primary);
  }
  .termin-inner { max-width: 880px; margin-inline: auto; }
  .termin-head { margin-bottom: 48px; }
  .termin-headline {
    font-size: clamp(2.25rem, 4.2vw, 3.75rem);
    line-height: 1.05;
    font-weight: 300;
    letter-spacing: -0.025em;
    margin-top: 8px;
    color: var(--color-fg-primary);
  }
  .termin-points {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    margin-bottom: 48px;
    padding-bottom: 48px;
    border-bottom: 1px solid var(--color-line);
  }
  .termin-point {
    padding-inline: 24px;
    border-right: 1px solid var(--color-line-faint);
  }
  .termin-point:first-child { padding-left: 0; }
  .termin-point:last-child { padding-right: 0; border-right: none; }
  .termin-point-value {
    font-size: 1.5rem;
    font-weight: 400;
    line-height: 1.2;
    margin-bottom: 6px;
    color: var(--color-fg-primary);
  }
  .termin-point-label {
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-fg-secondary);
  }

  /* Direkt-Link-Anzeige (Phase 1b dritte Stufe, 12.05.2026).
     Kein iframe mehr, ein einziger sichtbarer Button auf jedem Gerät. */
  .cal-direct { display: block; }
  .cal-direct-help {
    margin-top: 12px;
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--color-fg-secondary);
  }

  .termin-fallback {
    margin-top: 32px;
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--color-fg-secondary);
  }
  .termin-fallback a {
    color: var(--color-fg-primary);
    border-bottom: 1px solid var(--color-line);
    transition: border-color 0.2s ease;
  }
  .termin-fallback a:hover { border-bottom-color: var(--color-fg-primary); }
  .termin-cta-row { margin-top: 24px; }

  @media (max-width: 1024px) {
    .termin-detail { padding-block: 80px; }
    .termin-points { grid-template-columns: 1fr; gap: 24px; }
    .termin-point {
      padding-inline: 0; border-right: none;
      border-bottom: 1px solid var(--color-line-faint);
      padding-bottom: 24px;
    }
    .termin-point:last-child { border-bottom: none; padding-bottom: 0; }
  }
</style>
