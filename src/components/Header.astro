---
// Header Proimma Relaunch — Editorial Bold
// Stand 02.05.2026, Bau-Block 1.
// Sticky-Header auf Off-White mit Hairline unten und backdrop-filter.
// Wortmarke „Proimma" mit kleinem i, ohne Akzent-Punkt
// (Korrektur-Auftrag 30.04.2026).
// Vier Hauptnavigations-Punkte in Phase 1.
// Hover-Verhalten: Hairline-drüber, kein Schriftfarbenwechsel.

const navItems = [
  { label: 'Hausverwaltung', href: '/hausverwaltung' },
  { label: 'Maklerei',       href: '/maklerei' },
  { label: 'Über',           href: '/ueber-proimma' },
  { label: 'Kontakt',        href: '/kontakt' },
];
---

<header class="site-header">
  <div class="container-page nav-inner">
    <a href="/" class="wordmark" aria-label="Proimma GmbH Startseite">Proimma GmbH</a>

    <nav aria-label="Hauptnavigation" class="nav-links">
      {navItems.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
    </nav>

    <button
      type="button"
      class="nav-toggle"
      aria-label="Menü öffnen"
      aria-expanded="false"
      data-menu-toggle
    >
      <svg width="20" height="14" viewBox="0 0 20 14" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true">
        <line x1="0" y1="1"  x2="20" y2="1" />
        <line x1="0" y1="7"  x2="20" y2="7" />
        <line x1="0" y1="13" x2="20" y2="13" />
      </svg>
    </button>
  </div>
</header>

<!-- Mobile Menü als direkter Body-Geschwister-Eintrag des Headers, damit
     position: fixed gegen das Viewport-Origin greift. Innerhalb des Headers
     erzeugte der backdrop-filter einen eigenen Containing-Block und das Menü
     wurde auf iOS-Safari unsichtbar auf null Pixel Höhe begrenzt (Befund
     13.05.2026 mobile Sichtkontrolle). -->
<div id="mobile-menu" hidden class="mobile-menu">
  <nav aria-label="Mobile Navigation" class="container-page mobile-menu-inner">
    <ul>
      {navItems.map((item) => (
        <li><a href={item.href}>{item.label}</a></li>
      ))}
    </ul>
    <div class="mobile-menu-foot">
      <a class="btn-primary" href="/kontakt">Erstgespräch vereinbaren</a>
      <p class="meta mobile-menu-meta">Proimma GmbH · Bremer Straße 12 · 18057 Rostock</p>
    </div>
  </nav>
</div>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(250, 250, 248, 0.92);
    backdrop-filter: saturate(140%) blur(14px);
    -webkit-backdrop-filter: saturate(140%) blur(14px);
    border-bottom: 1px solid var(--color-line-faint);
  }

  .nav-inner {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 32px;
    padding-block: 28px 26px;
  }

  .wordmark {
    font-size: 1.5rem;
    font-weight: 300;
    letter-spacing: -0.02em;
    color: var(--color-fg-primary);
    line-height: 1;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .nav-links {
    display: none;
    gap: 40px;
    font-size: 0.9375rem;
    font-weight: 400;
  }

  .nav-links a {
    position: relative;
    padding-block: 14px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    color: var(--color-fg-primary);
  }
  .nav-links a::after {
    content: "";
    position: absolute;
    left: 0; right: 0; bottom: 8px;
    height: 1px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s ease;
  }
  .nav-links a:hover::after,
  .nav-links a:focus-visible::after { transform: scaleX(1); }
  .nav-links a:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 6px;
  }

  .nav-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 44px;
    width: 44px;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    color: var(--color-fg-primary);
    background: transparent;
    cursor: pointer;
  }
  .nav-toggle:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }

  @media (min-width: 1024px) {
    .nav-links { display: flex; }
    .nav-toggle { display: none; }
  }

  .mobile-menu {
    position: fixed;
    inset: 0;
    top: 73px;
    background: var(--color-bg-primary);
    z-index: 40;
    overflow-y: auto;
  }

  @media (min-width: 1024px) {
    .mobile-menu { display: none; }
  }

  .mobile-menu-inner {
    padding-block: 40px;
    display: flex;
    flex-direction: column;
    min-height: calc(100vh - 73px);
  }

  .mobile-menu ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .mobile-menu ul li a {
    display: block;
    padding: 20px 0;
    font-size: 1.875rem;
    font-weight: 300;
    letter-spacing: -0.02em;
    color: var(--color-fg-primary);
    border-bottom: 1px solid var(--color-line);
    min-height: 44px;
  }

  .mobile-menu-foot { margin-top: auto; padding-top: 40px; }
  .mobile-menu-foot .btn-primary { width: 100%; justify-content: center; }
  .mobile-menu-meta { margin-top: 24px; }
</style>

<script>
  const toggle = document.querySelector('[data-menu-toggle]');
  const menu = document.getElementById('mobile-menu');
  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const isOpen = menu.hasAttribute('hidden') === false;
      if (isOpen) {
        menu.setAttribute('hidden', '');
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', 'Menü öffnen');
        document.body.style.overflow = '';
      } else {
        menu.removeAttribute('hidden');
        toggle.setAttribute('aria-expanded', 'true');
        toggle.setAttribute('aria-label', 'Menü schließen');
        document.body.style.overflow = 'hidden';
      }
    });
    // Schließen mit Escape
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !menu.hasAttribute('hidden')) {
        menu.setAttribute('hidden', '');
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', 'Menü öffnen');
        document.body.style.overflow = '';
      }
    });
  }
</script>
